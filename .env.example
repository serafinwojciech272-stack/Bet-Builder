# ---- Server-side only (never prefix with VITE_) ----

# Odds providers, tried in this order: SportsGameOdds -> ParlayAPI -> The Odds API
SPORTSGAMEODDS_API_KEY=
PARLAY_API_KEY=
ODDS_API_KEY=
# Polish bookmaker feed (STS / Superbet) for the Daily Coupon
ODDS_API_IO_KEY=
# Optional event fallback
THESPORTSDB_API_KEY=

# Core Engine is the single AI gateway for Bet Builder.
# Model selection, fallback, escalation and consensus are owned by Core Engine.
# Do not configure OPENROUTER_API_KEY in this project.
CORE_ENGINE_URL=https://core-engine-34uu.onrender.com
CORE_ENGINE_API_KEY=
CORE_ENGINE_E2E_TOKEN=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of browser origins allowed by CORS
ALLOWED_ORIGINS=https://bet-builder-preview.vercel.app,https://bet-builder-live.onrender.com

# ---- Public (bundled into the browser) ----
VITE_CORE_ENGINE_GATEWAY_URL=https://bet-builder-api-live.onrender.com
