{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "qa/full-flow-weight-regression": false
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,POST,OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization, X-Core-Engine-E2E-Token"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vary",
          "value": "Origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/live-odds",
      "destination": "https://bet-builder-api-live.onrender.com/api/odds"
    },
    {
      "source": "/api/odds",
      "destination": "https://bet-builder-api-live.onrender.com/api/odds"
    },
    {
      "source": "/api/daily-coupon",
      "destination": "https://bet-builder-api-live.onrender.com/api/daily-coupon"
    },
    {
      "source": "/api/sportscore-smoke",
      "destination": "https://bet-builder-api-live.onrender.com/api/sportscore-smoke"
    },
    {
      "source": "/api/research",
      "destination": "https://bet-builder-api-live.onrender.com/api/research"
    },
    {
      "source": "/api/core-engine-persistence-e2e",
      "destination": "https://bet-builder-api-live.onrender.com/api/core-engine-persistence-e2e"
    },
    {
      "source": "/api/health",
      "destination": "https://bet-builder-api-live.onrender.com/health"
    },
    {
      "source": "/api/core-engine",
      "destination": "https://bet-builder-api-live.onrender.com/api/core-engine"
    },
    {
      "source": "/api/decision-reasoning",
      "destination": "https://bet-builder-api-live.onrender.com/api/decision-reasoning"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
